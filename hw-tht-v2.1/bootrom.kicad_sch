	(text "BOOT ROM: 32 KB option ROM on the ISA memory bus (experimental)"
		(exclude_from_sim no)
		(at 30.48 25.4 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "fbec3e06-1d21-5b1d-ba70-deefbf246673")
	)
	(text "U16 compares SA19..SA15 with 1 1 JP3 JP2 JP1 and needs ROM_EN = 1 (GPIO2; R35 keeps the ROM off until the firmware enables it)."
		(exclude_from_sim no)
		(at 30.48 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ba82e7bf-5f94-5064-8873-746e1881f980")
	)
	(text "~ROM_CS selects the flash; its outputs drive the ISA data lines directly while ~SMEMR is low (no bus buffer)."
		(exclude_from_sim no)
		(at 30.48 36.83 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c4976e87-bc24-54cb-96db-5bb87f894c32")
	)
	(text "Base address (JP3 JP2 JP1): 000 = C0000h, 001 = C8000h, 010 = D0000h (default), 011 = D8000h, 100 = E0000h, 101 = E8000h."
		(exclude_from_sim no)
		(at 30.48 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "49e742f7-2128-5cb6-a269-7a1ab177f23d")
	)
	(text "Each jumper: pads 1-2 are bridged by a track (cut it and bridge 2-3 to change the bit)."
		(exclude_from_sim no)
		(at 30.48 156.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6898af69-8ac0-5d98-904f-61223286e7f5")
	)
	(text "JP4 2-3: flash WE# = ~SMEMW, so a DOS tool can program the flash in the card."
		(exclude_from_sim no)
		(at 152.4 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
