	(text "BOOT ROM: 32 KB option ROM on the ISA memory bus (experimental)"
		(exclude_from_sim no)
		(at 30.48 25.4 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "fbec3e06-1d21-5b1d-ba70-deefbf246673")
	)
	(text "U16 decodes SA19..SA15: outputs 5, 6 and 7 are low in C8000h-CFFFFh, D0000h-D7FFFh and D8000h-DFFFFh while ~ROM_EN (GPIO2) is low."
		(exclude_from_sim no)
		(at 30.48 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ba82e7bf-5f94-5064-8873-746e1881f980")
	)
	(text "R35 keeps the ROM off until the firmware enables it. The closed jumper picks the block: its output is the flash CE; OE is ~SMEMR,"
		(exclude_from_sim no)
		(at 30.48 36.83 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c4976e87-bc24-54cb-96db-5bb87f894c32")
	)
	(text "so the flash drives the ISA data lines only during a memory read in its window."
		(exclude_from_sim no)
		(at 30.48 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "31d0944e-62cd-53a8-a7a8-6722cb07e215")
	)
	(text "Base address: close exactly one of JP1 (C8000h), JP2 (D0000h, default: bridged by a track, cut it to change) and JP3 (D8000h)."
		(exclude_from_sim no)
		(at 30.48 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "49e742f7-2128-5cb6-a269-7a1ab177f23d")
	)
	(text "WE is tied high: program the flash in a programmer (it is in a socket)."
		(exclude_from_sim no)
		(at 152.4 135.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
